{
  "name": "@narumitw/pi-web",
  "version": "0.5.0",
  "description": "Local-first web UI for pi-coding-agent.",
  "keywords": [
    "pi-package"
  ],
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narumiruna/pi-web.git"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "bin": {
    "pi-web": "dist/server/cli.js"
  },
  "pi": {
    "extensions": [
      "./dist/extensions/pi-web.js"
    ]
  },
  "scripts": {
    "dev": "bash -c 'trap \"kill 0\" EXIT; npm run dev:server & npm run dev:client & wait'",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.extension.json && vite build",
    "prepack": "npm run build",
    "start": "node dist/server/index.js",
    "lint": "biome ci .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.extension.json --noEmit",
    "test": "vitest run",
    "ci": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.3",
    "@fastify/static": "^10.1.0",
    "@fastify/websocket": "^11.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "fastify": "^5.6.1",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
